# Copy to .env and fill in. Never commit .env.

# --- Superlinked SIE (required for live runs; without it the server replays recorded SIE outputs) ---
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com      # or your self-hosted SIE for real PHI
MODEL_BACKEND=sie                              # sie | mock (mock replays backend/fixtures)

# --- Memory ---
MEMORY_BACKEND=auto                            # auto (cognee if it starts) | cognee | local

# --- Server ---
APP_ORIGIN=http://127.0.0.1:8010               # CORS is locked to this origin
PILLSPARK_DATA_DIR=                            # default: ./data (orders, uploads, memory, cognee stores)
PILLSPARK_VERIFIED_MIN=0.90
PILLSPARK_REVIEW_MIN=0.70
PILLSPARK_RECORD=1                             # record live SIE outputs for offline replay
PILLSPARK_REPLAY_SPEED=1.0                     # mock mode: fraction of recorded latency to wait

# --- Optional: frontier baseline for the benchmark (not used by the pipeline) ---
FRONTIER_PROVIDER=anthropic
FRONTIER_API_KEY=
